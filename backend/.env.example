DJANGO_SECRET_KEY=replace-with-a-long-random-secret
MISTRAL_API_KEY=
# Local PostgreSQL URL. On Render, set DATABASE_URL to the database's Internal Database URL.
DATABASE_URL=postgresql://postgres:your-local-password@localhost:5432/fithub_elite
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
